{
  "redirects": [
    { "source": "/admin", "destination": "https://admin.thekada.in", "permanent": true },
    { "source": "/admin/(.*)", "destination": "https://admin.thekada.in", "permanent": true },
    { "source": "/products", "destination": "/work", "permanent": true },
    { "source": "/ecosystem", "destination": "/work", "permanent": true },
    { "source": "/request-proposal", "destination": "/start-project", "permanent": true },
    { "source": "/proposal", "destination": "/start-project", "permanent": true },
    { "source": "/quote", "destination": "/start-project", "permanent": true },
    { "source": "/internship", "destination": "/careers", "permanent": true },
    { "source": "/internships", "destination": "/careers", "permanent": true },
    { "source": "/careers/internship", "destination": "/careers", "permanent": true },
    { "source": "/technology", "destination": "/services", "permanent": true },
    { "source": "/insights", "destination": "/", "permanent": true },
    { "source": "/press", "destination": "/about", "permanent": true },
    { "source": "/investor-relations", "destination": "/about", "permanent": true }
  ],
  "headers": [
    {
      "source": "/auth/action(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/auth/action", "destination": "/auth/action.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
