{
  "hosting": {
    "target": "thekada-web",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/admin", "destination": "https://admin.thekada.in", "type": 301 },
      { "source": "/admin/**", "destination": "https://admin.thekada.in", "type": 301 },
      { "source": "/products", "destination": "/work", "type": 301 },
      { "source": "/ecosystem", "destination": "/work", "type": 301 },
      { "source": "/request-proposal", "destination": "/start-project", "type": 301 },
      { "source": "/proposal", "destination": "/start-project", "type": 301 },
      { "source": "/quote", "destination": "/start-project", "type": 301 },
      { "source": "/internship", "destination": "/careers/internship", "type": 301 },
      { "source": "/internships", "destination": "/careers/internship", "type": 301 },
      { "source": "/technology", "destination": "/services", "type": 301 },
      { "source": "/insights", "destination": "/", "type": 301 },
      { "source": "/press", "destination": "/about", "type": 301 },
      { "source": "/investor-relations", "destination": "/about", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "admin"
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
