rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : 'anonymous';
    }

    function orgId() {
      return signedIn() && request.auth.token.organizationId != null
        ? request.auth.token.organizationId
        : '';
    }

    function productIds() {
      return signedIn() && request.auth.token.productIds != null
        ? request.auth.token.productIds
        : [];
    }

    function hasAnyRole(roles) {
      return signedIn() && role() in roles;
    }

    function isSuperAdmin() {
      return hasAnyRole(['super_admin', 'founder']);
    }

    function isExecutive() {
      return hasAnyRole(['super_admin', 'founder', 'director']);
    }

    function isStaff() {
      return hasAnyRole([
        'super_admin',
        'founder',
        'director',
        'department_head',
        'manager',
        'team_lead',
        'employee',
        'support_agent'
      ]);
    }

    function isFinanceRole() {
      return hasAnyRole(['super_admin', 'founder', 'director', 'finance_manager']);
    }

    function isHrRole() {
      return hasAnyRole(['super_admin', 'founder', 'director', 'department_head', 'hr_manager']);
    }

    function isSupportRole() {
      return hasAnyRole(['super_admin', 'founder', 'director', 'manager', 'support_agent']);
    }

    function isPartnerRole() {
      return hasAnyRole(['franchise_owner', 'partner']);
    }

    function belongsToOrg(data) {
      return !('organizationId' in data) || data.organizationId == orgId();
    }

    function productAllowed(data) {
      return !('productId' in data) || data.productId in productIds() || isExecutive();
    }

    function canReadManaged(data) {
      return isExecutive() || (isStaff() && belongsToOrg(data) && productAllowed(data)) || (isPartnerRole() && belongsToOrg(data));
    }

    function canWriteManaged(existingData, incomingData) {
      return isExecutive()
        || (
          isStaff()
          && belongsToOrg(existingData)
          && belongsToOrg(incomingData)
          && productAllowed(incomingData)
          && !('role' in incomingData)
          && !('permissions' in incomingData)
        );
    }

    function canCreateManaged(incomingData) {
      return isExecutive()
        || (
          isStaff()
          && belongsToOrg(incomingData)
          && productAllowed(incomingData)
          && !('role' in incomingData)
          && !('permissions' in incomingData)
        );
    }

    function managedCollection(collectionId) {
      return collectionId in [
        'users',
        'organizations',
        'departments',
        'employees',
        'internships',
        'careers',
        'applications',
        'proposals',
        'contacts',
        'crm_leads',
        'tickets',
        'franchises',
        'partners',
        'products',
        'subscriptions',
        'invoices',
        'transactions',
        'notifications',
        'reports',
        'analytics',
        'settings'
      ];
    }

    // ── Internships ────────────────────────────────────────────────────
    // The public internship portal was removed from thekada.in, so nothing
    // outside the staff admin console reads or writes these collections.
    match /internship_applications/{id} {
      allow read, write: if isStaff();
    }

    // Intern records, leave requests and weekly reports are staff-managed.
    match /internships/{id}        { allow read, write: if isStaff(); }
    match /internship_leaves/{id}  { allow read, write: if isStaff(); }
    match /internship_reports/{id} { allow read, write: if isStaff(); }

    // Certificates: staff issue/manage only.
    match /internship_certificates/{id} {
      allow read, write: if isStaff();
    }

    match /newsletter_subscribers/{id} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow read, delete: if isExecutive();
      allow update: if false;
    }

    // ── Public form intake ──────────────────────────────────────────────
    // Marketing-site forms may CREATE a submission (shape-validated). Only
    // staff can read them; they're never publicly readable or editable.
    function isEmail(v) {
      return v is string && v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }
    function isText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    match /contact_messages/{id} {
      allow create: if isText(request.resource.data.name, 1, 120)
        && isEmail(request.resource.data.email)
        && isText(request.resource.data.message, 10, 5000);
      allow read: if isStaff();
      allow update, delete: if isExecutive();
    }

    match /proposal_requests/{id} {
      allow create: if isText(request.resource.data.name, 1, 120)
        && isEmail(request.resource.data.email)
        && isText(request.resource.data.message, 10, 5000);
      allow read: if isStaff();
      allow update, delete: if isExecutive();
    }

    // Public site and product enquiries. Visitors can submit only; staff can
    // review leads, and only executives can change or remove a submission.
    match /contact_requests/{id} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'topic', 'message', 'status', 'createdAt',
          'createdAtIso', 'source', 'company', 'needs', 'budget', 'timeline',
          'page', 'referenceId', 'userAgent', 'brand', 'city'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'topic', 'message', 'status', 'createdAt',
          'createdAtIso', 'source'
        ])
        && isText(request.resource.data.name, 1, 120)
        && isEmail(request.resource.data.email)
        && isText(request.resource.data.phone, 0, 40)
        && isText(request.resource.data.topic, 1, 40)
        && isText(request.resource.data.message, 1, 2000)
        && request.resource.data.status == 'new'
        && isText(request.resource.data.createdAtIso, 1, 40)
        && isText(request.resource.data.source, 1, 80)
        && request.resource.data.createdAt == request.time
        && (!('company' in request.resource.data) || isText(request.resource.data.company, 0, 120))
        && (!('needs' in request.resource.data) || (
          request.resource.data.needs is list
          && request.resource.data.needs.size() <= 9
          && request.resource.data.needs.hasOnly([
            'Web application', 'Mobile app (iOS/Android)', 'SaaS platform',
            'Digital marketing & growth', 'Business software / ERP', 'CRM / HRM system',
            'AI & automation', 'API & payments integration', 'Fix or modernise an existing app'
          ])
        ))
        && (!('budget' in request.resource.data) || isText(request.resource.data.budget, 0, 100))
        && (!('timeline' in request.resource.data) || isText(request.resource.data.timeline, 0, 100))
        && (!('page' in request.resource.data) || request.resource.data.page in ['contact', 'start-project'])
        && (!('referenceId' in request.resource.data) || isText(request.resource.data.referenceId, 5, 40))
        && (!('userAgent' in request.resource.data) || request.resource.data.userAgent == null || isText(request.resource.data.userAgent, 0, 300))
        && (!('brand' in request.resource.data) || isText(request.resource.data.brand, 1, 60))
        && (!('city' in request.resource.data) || isText(request.resource.data.city, 0, 80));
      allow read: if isStaff();
      allow update, delete: if isExecutive();
    }

    match /account_deletion_requests/{id} {
      allow create: if isText(request.resource.data.identifier, 3, 200);
      allow read: if isStaff();
      allow update, delete: if isExecutive();
    }

    match /activity_logs/{id} {
      allow read: if isExecutive();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isExecutive() || request.auth.uid == userId;
      allow create: if isExecutive() && request.resource.data.uid == userId && belongsToOrg(request.resource.data);
      allow update: if isExecutive() && belongsToOrg(resource.data) && belongsToOrg(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /organizations/{organizationId} {
      allow read: if isExecutive() || (signedIn() && organizationId == orgId());
      allow create, update, delete: if isSuperAdmin();

      match /{collectionId}/{documentId} {
        allow read: if managedCollection(collectionId) && canReadManaged(resource.data);
        allow create: if managedCollection(collectionId) && canCreateManaged(request.resource.data);
        allow update: if managedCollection(collectionId) && canWriteManaged(resource.data, request.resource.data);
        allow delete: if managedCollection(collectionId) && isExecutive() && belongsToOrg(resource.data);
      }
    }

    match /{collectionId}/{documentId} {
      allow read: if managedCollection(collectionId) && canReadManaged(resource.data);
      allow create: if managedCollection(collectionId) && canCreateManaged(request.resource.data);
      allow update: if managedCollection(collectionId) && canWriteManaged(resource.data, request.resource.data);
      allow delete: if managedCollection(collectionId) && isExecutive() && belongsToOrg(resource.data);
    }

    match /audit_logs/{logId} {
      allow read: if isExecutive();
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.organizationId == orgId();
      allow update, delete: if false;
    }

    match /public_content/{docId} {
      allow read: if true;
      allow create, update, delete: if isExecutive();
    }

    match /integrations/{integrationId} {
      allow read, write: if isSuperAdmin();
    }

    match /system_jobs/{jobId} {
      allow read: if isExecutive();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
